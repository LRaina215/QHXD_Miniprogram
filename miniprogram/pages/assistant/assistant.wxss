.page { height: 100vh; display: flex; flex-direction: column; }
.chat { flex: 1; min-height: 0; }
.chat-in { padding: 24rpx 28rpx 0; }

.hello { padding: 36rpx 32rpx; border-radius: 32rpx; background: var(--surface); box-shadow: 0 2rpx 4rpx rgba(21, 23, 26, 0.04), 0 8rpx 32rpx rgba(21, 23, 26, 0.05); margin-bottom: 28rpx; }
.hello-logo { width: 88rpx; height: 88rpx; border-radius: 24rpx; }
.hello-title { display: block; margin-top: 20rpx; font-size: 38rpx; font-weight: 720; }
.hello-sub { display: block; margin-top: 10rpx; font-size: 25rpx; color: var(--ink-2); }
.ex { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.ex-item { margin: 0 14rpx 14rpx 0; height: 60rpx; line-height: 60rpx; padding: 0 22rpx; border-radius: 999rpx; border: 2rpx solid var(--line-2); font-size: 24rpx; font-weight: 550; background: var(--surface); }

.msg { display: flex; align-items: flex-end; margin-bottom: 22rpx; }
.msg.me { justify-content: flex-end; }
.msg.sys { justify-content: center; }
.avatar { width: 60rpx; height: 60rpx; border-radius: 30rpx; flex: none; margin-right: 14rpx; }
.bubble { max-width: 78%; padding: 20rpx 26rpx; }
.me .bubble { background: var(--ink); color: #fff; border-radius: 32rpx 32rpx 8rpx 32rpx; }
.bot .bubble { background: var(--surface); border-radius: 32rpx 32rpx 32rpx 8rpx; box-shadow: 0 2rpx 6rpx rgba(21, 23, 26, 0.05); }
.sys .bubble { max-width: 90%; padding: 12rpx 22rpx; border-radius: 999rpx; background: var(--surface-3); }
.sys .text { font-size: 23rpx; color: var(--ink-2); }
.text { font-size: 28rpx; line-height: 1.55; word-break: break-all; }
.meta { display: block; margin-top: 8rpx; font-size: 20rpx; color: var(--ink-3); }
.bottom-pad { height: 24rpx; }

.bar { display: flex; align-items: center; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 2rpx solid var(--line); }
.mode { width: 76rpx; height: 76rpx; border-radius: 38rpx; display: flex; align-items: center; justify-content: center; background: var(--surface-2); flex: none; }
.mode image { width: 40rpx; height: 40rpx; }
.talk { flex: 1; margin-left: 16rpx; height: 84rpx; line-height: 84rpx; border-radius: 24rpx; text-align: center; background: var(--brand); color: #fff; font-size: 29rpx; font-weight: 650; letter-spacing: 4rpx; }
.talk.on { background: var(--brand-deep); }
.input { flex: 1; margin-left: 16rpx; height: 84rpx; padding: 0 24rpx; border-radius: 24rpx; background: var(--surface-2); font-size: 28rpx; }
.send { width: 84rpx; height: 84rpx; margin-left: 14rpx; border-radius: 24rpx; background: var(--brand); display: flex; align-items: center; justify-content: center; flex: none; }
.send.off { background: var(--surface-3); }
.send image { width: 40rpx; height: 40rpx; }

.rec { position: fixed; left: 50%; top: 40%; transform: translate(-50%, -50%); width: 320rpx; padding: 36rpx 0; border-radius: 32rpx; background: rgba(21, 23, 26, 0.86); color: #fff; font-size: 25rpx; display: flex; flex-direction: column; align-items: center; z-index: 80; }
.rec-wave { display: flex; align-items: center; height: 80rpx; margin-bottom: 16rpx; }
.rec-b { width: 10rpx; height: 24rpx; margin: 0 6rpx; border-radius: 5rpx; background: #8ea6ff; animation: wave 0.9s ease-in-out infinite; }
@keyframes wave { 0%, 100% { height: 20rpx; } 50% { height: 72rpx; } }
