/* 任务中心 - 执行台 */
.page-tasks {
  padding-bottom: 44rpx;
  padding-bottom: calc(44rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  background: #F4F6F8;
}

.mission-hero {
  margin: 16rpx 20rpx 12rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #15181C;
  color: #FFFFFF;
}

.mission-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
}

.mission-title-block {
  flex: 1;
  min-width: 0;
}

.mission-kicker {
  display: block;
  color: rgba(255, 255, 255, 0.58);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.mission-title {
  display: block;
  margin-top: 4rpx;
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.12;
}

.mission-subtitle {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  overflow-wrap: anywhere;
}

.mission-permit {
  flex-shrink: 0;
  max-width: 100%;
  box-sizing: border-box;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.mission-permit.ready {
  color: #90F2B0;
  background: rgba(144, 242, 176, 0.13);
}

.mission-permit.locked {
  color: #FFD58A;
  background: rgba(255, 213, 138, 0.13);
}

.mission-status-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 22rpx;
}

.mission-status-item {
  min-width: 0;
  min-height: 76rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
}

.mission-status-item.ok { color: #90F2B0; }
.mission-status-item.warn { color: #FFD58A; }
.mission-status-item.bad { color: #FFB1AC; }

.status-label {
  color: rgba(255, 255, 255, 0.48);
  font-size: 17rpx;
  font-weight: 700;
}

.status-value {
  margin-top: 4rpx;
  color: currentColor;
  font-size: 23rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.current-mission-panel {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #15181C;
}

.current-mission-main {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.current-mission-main.standby {
  opacity: 0.86;
}

.task-glyph,
.task-item-icon,
.receipt-mark,
.action-code {
  flex-shrink: 0;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #15181C;
  background: #F2F2F7;
  font-family: 'SF Mono', 'Menlo', 'Courier New', monospace;
  font-size: 20rpx;
  font-weight: 800;
}

.task-info {
  flex: 1;
  min-width: 0;
}

.task-type {
  display: block;
  color: #15181C;
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-desc {
  display: block;
  margin-top: 3rpx;
  color: #8E8E93;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-status {
  flex-shrink: 0;
}

.action-card {
  margin-top: 14rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.action-btn {
  min-width: 0;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #F9F9FB;
  border: 1rpx solid #EEF0F3;
}

.action-btn.primary {
  background: #E8F0FE;
  border-color: #D8E6FF;
}

.action-btn.warn {
  background: #FFF6E6;
  border-color: #FFE7BB;
}

.action-btn.disabled {
  opacity: 0.52;
}

.action-btn:active {
  transform: scale(0.985);
}

.action-copy {
  flex: 1;
  min-width: 0;
}

.action-title {
  display: block;
  color: #15181C;
  font-size: 25rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-desc {
  display: block;
  margin-top: 4rpx;
  color: #8E8E93;
  font-size: 19rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.receipt-list,
.task-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.receipt-item,
.task-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  padding: 16rpx;
  background: #F9F9FB;
  border-radius: 12rpx;
}

.receipt-item.rejected {
  background: #FFF5F5;
}

.receipt-item.accepted .receipt-mark {
  color: #248A3D;
  background: #E3F5E8;
}

.receipt-item.rejected .receipt-mark {
  color: #C42E2A;
  background: #FEE8E7;
}

.receipt-copy,
.task-item-info {
  flex: 1;
  min-width: 0;
}

.receipt-command,
.task-item-type {
  display: block;
  color: #15181C;
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.receipt-detail,
.task-item-time {
  display: block;
  margin-top: 3rpx;
  color: #8E8E93;
  font-size: 19rpx;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.task-item-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.task-item-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.task-cancel-btn {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  border-radius: 10rpx;
  color: #C42E2A;
  background: #FEE8E7;
  font-size: 20rpx;
  font-weight: 700;
}

.task-cancel-btn:active {
  background: #FFD8D6;
}

.task-event-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.task-event-item {
  position: relative;
  display: flex;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F9F9FB;
}

.task-event-item.info .task-event-dot {
  background: #1A6DD4;
}

.task-event-item.ok {
  background: #F2FBF5;
}

.task-event-item.ok .task-event-dot {
  background: #248A3D;
}

.task-event-item.bad {
  background: #FFF5F5;
}

.task-event-item.bad .task-event-dot {
  background: #C42E2A;
}

.task-event-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #8E8E93;
}

.task-event-copy {
  flex: 1;
  min-width: 0;
}

.task-event-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.task-event-type {
  color: #15181C;
  font-size: 25rpx;
  font-weight: 800;
}

.task-event-time {
  flex-shrink: 0;
  color: #8E8E93;
  font-size: 19rpx;
  font-family: 'SF Mono', 'Menlo', 'Courier New', monospace;
}

.task-event-detail {
  display: block;
  margin-top: 5rpx;
  color: #3A3A3C;
  font-size: 22rpx;
  line-height: 1.38;
  overflow-wrap: anywhere;
}

.task-event-meta {
  display: block;
  margin-top: 6rpx;
  color: #8E8E93;
  font-size: 19rpx;
  overflow-wrap: anywhere;
}

.card-subtitle {
  margin-left: auto;
  font-size: 20rpx;
  color: #C7C7CC;
}
