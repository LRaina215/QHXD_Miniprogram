/* 数据图表 - 简约风格 */
.page-charts { padding-bottom: 40rpx; }

/* 时间选择器 */
.time-filter {
  display: flex; justify-content: center; gap: 10rpx;
  padding: 16rpx 20rpx; background: #FFFFFF; border-bottom: 1rpx solid #E5E5EA;
}
.time-option {
  padding: 10rpx 28rpx; border-radius: 16rpx;
  font-size: 24rpx; color: #8E8E93; background: #F9F9FB;
  transition: all 0.15s;
}
.time-option.active { background: #1C1C1E; color: #FFFFFF; font-weight: 500; }
.time-option:active { opacity: 0.8; }

/* 图表卡片 */
.chart-card { margin-top: 0; }
.chart-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 12rpx;
}
.chart-title { display: flex; align-items: center; font-size: 26rpx; font-weight: 600; color: #1C1C1E; }
.chart-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 8rpx; display: inline-block; }
.chart-dot.battery { background: #3A3A3C; }
.chart-dot.co      { background: #8E8E93; }
.chart-dot.ch4     { background: #AEAEB2; }
.chart-dot.aqi     { background: #636366; }
.chart-value { font-size: 26rpx; font-weight: 700; color: #1C1C1E; font-variant-numeric: tabular-nums; }
.chart-container { width: 100%; height: 260rpx; background: #F9F9FB; border-radius: 10rpx; overflow: hidden; }
.chart-canvas { width: 100%; height: 100%; }

/* 统计 */
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; }
.stat-item { background: #F9F9FB; border-radius: 10rpx; padding: 14rpx; text-align: center; }
.stat-label { font-size: 18rpx; color: #AEAEB2; display: block; margin-bottom: 2rpx; }
.stat-value { font-size: 28rpx; font-weight: 700; color: #1C1C1E; display: block; }
.stat-desc { font-size: 18rpx; color: #C7C7CC; display: block; margin-top: 1rpx; }
.clear-data-btn {
  text-align: center; padding: 16rpx; margin-top: 12rpx;
  font-size: 22rpx; color: #C42E2A; background: #FEE8E7; border-radius: 10rpx;
}
.clear-data-btn:active { background: #FFD8D6; }
