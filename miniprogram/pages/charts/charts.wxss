/* 数据页 - 运行数据台 */
.page-charts {
  padding-bottom: 44rpx;
  padding-bottom: calc(44rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  background: #F4F6F8;
}

.data-hero {
  margin: 16rpx 20rpx 12rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #15181C;
  color: #FFFFFF;
}

.data-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
}

.data-title-block {
  flex: 1;
  min-width: 0;
}

.data-kicker,
.section-kicker {
  display: block;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.data-kicker {
  color: rgba(255, 255, 255, 0.58);
}

.data-title {
  display: block;
  margin-top: 4rpx;
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.12;
}

.data-subtitle {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  overflow-wrap: anywhere;
}

.data-live-badge {
  flex-shrink: 0;
  max-width: 100%;
  box-sizing: border-box;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #90F2B0;
  background: rgba(144, 242, 176, 0.13);
  font-size: 22rpx;
  font-weight: 800;
}

.runtime-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 22rpx;
}

.runtime-item {
  min-width: 0;
  min-height: 108rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.08);
}

.runtime-label {
  display: block;
  color: rgba(255, 255, 255, 0.52);
  font-size: 19rpx;
  font-weight: 700;
}

.runtime-value {
  display: block;
  margin-top: 8rpx;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.runtime-value.compact {
  font-size: 26rpx;
  line-height: 1.25;
  white-space: normal;
  overflow-wrap: anywhere;
}

.runtime-detail {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #15181C;
}

.runtime-detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F0F3;
}

.runtime-detail-row:last-child {
  border-bottom: none;
}

.runtime-detail-row text {
  flex-shrink: 0;
  color: #8E8E93;
  font-size: 21rpx;
  font-weight: 700;
}

.runtime-detail-value {
  min-width: 0;
  color: #15181C;
  font-size: 22rpx;
  font-weight: 700;
  text-align: right;
  overflow-wrap: anywhere;
}

.runtime-detail-row.command.ok .runtime-detail-value {
  color: #248A3D;
}

.runtime-detail-row.command.bad .runtime-detail-value {
  color: #C42E2A;
}

.runtime-detail-row.command.muted .runtime-detail-value {
  color: #8E8E93;
}

.trend-section {
  margin-top: 14rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 0 20rpx 10rpx;
}

.section-kicker {
  color: #8E8E93;
}

.section-title {
  display: block;
  margin-top: 2rpx;
  color: #15181C;
  font-size: 30rpx;
  font-weight: 800;
}

.time-filter {
  flex-shrink: 0;
  display: flex;
  gap: 6rpx;
  padding: 5rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.time-option {
  min-width: 58rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #8E8E93;
  font-weight: 700;
}

.time-option.active {
  background: #15181C;
  color: #FFFFFF;
}

.time-option:active {
  opacity: 0.8;
}

.chart-card {
  margin-top: 0;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.chart-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #15181C;
}

.chart-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  display: inline-block;
}

.chart-dot.battery { background: #15181C; }
.chart-dot.temp { background: #5E6A75; }
.chart-dot.humidity { background: #7A828C; }

.chart-value {
  font-size: 26rpx;
  font-weight: 800;
  color: #15181C;
  font-variant-numeric: tabular-nums;
}

.chart-container {
  width: 100%;
  height: 260rpx;
  background: #F9F9FB;
  border-radius: 12rpx;
  overflow: hidden;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.stat-item {
  min-width: 0;
  background: #F9F9FB;
  border-radius: 10rpx;
  padding: 14rpx;
  text-align: center;
}

.stat-item.muted {
  opacity: 0.62;
}

.stat-label {
  font-size: 18rpx;
  color: #8E8E93;
  display: block;
  margin-bottom: 2rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 800;
  color: #15181C;
  display: block;
}

.stat-desc {
  font-size: 18rpx;
  color: #C7C7CC;
  display: block;
  margin-top: 1rpx;
}

.clear-data-btn {
  text-align: center;
  min-height: 56rpx;
  padding: 16rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #C42E2A;
  background: #FEE8E7;
  border-radius: 10rpx;
}

.clear-data-btn:active {
  background: #FFD8D6;
}
