<!-- 首页：仪表盘 -->
<view class="page-dashboard">

  <!-- 运行驾驶舱 -->
  <view class="cockpit-hero">
    <view class="hero-top">
      <view class="hero-copy">
        <text class="hero-kicker">LINGXUN SENTINEL</text>
        <text class="hero-title">车载运行驾驶舱</text>
        <text class="hero-subtitle">{{systemMode}} · {{dataSource}} · {{lastUpdateTime}}</text>
      </view>
      <view class="hero-state {{restOnline || wsConnected ? 'online' : 'offline'}}">
        <text class="hero-state-dot"></text>
        <text>{{restOnline || wsConnected ? '在线' : '离线'}}</text>
      </view>
    </view>

    <view class="hero-link-grid">
      <view class="hero-link-item {{cloudOnline ? 'ok' : 'bad'}}">
        <text class="link-label">Cloud</text>
        <text class="link-value">{{cloudOnline ? '在线' : '离线'}}</text>
      </view>
      <view class="hero-link-item {{rkOnline ? 'ok' : 'bad'}}">
        <text class="link-label">RK3588</text>
        <text class="link-value">{{rkOnline ? '在线' : '离线'}}</text>
      </view>
      <view class="hero-link-item {{wsConnected ? 'ok' : 'warn'}}">
        <text class="link-label">链路</text>
        <text class="link-value">{{wsConnected ? 'WSS' : 'REST'}}</text>
      </view>
      <view class="hero-link-item {{publicControlEnabled ? 'ok' : 'warn'}}">
        <text class="link-label">控制</text>
        <text class="link-value">{{publicControlEnabled ? '开启' : '保护'}}</text>
      </view>
    </view>

    <view class="stale-banner" wx:if="{{staleWarning}}">
      <text>{{staleWarning}}</text>
    </view>

    <view class="stale-banner error" wx:if="{{lastError}}">
      <text>{{lastError}}</text>
    </view>

    <view class="alert-banner {{alarmActive ? 'active' : ''}}" wx:if="{{alarmActive}}" bindtap="goToAlarms">
      <text class="alert-icon">!</text>
      <text class="alert-text">{{alarmMessage}}</text>
      <text class="alert-arrow">›</text>
    </view>

    <view class="hero-metrics">
      <view class="hero-metric battery">
        <text class="metric-label">电量</text>
        <text class="metric-value" style="color: {{batteryColor}};">{{robot.battery}}%</text>
        <view class="metric-bar">
          <view class="metric-bar-fill" style="width: {{batteryBarWidth}}%; background: {{batteryColor}};"></view>
        </view>
      </view>
      <view class="hero-metric">
        <text class="metric-label">当前任务</text>
        <text class="metric-value small">{{currentTaskText}}</text>
        <text class="metric-note">{{currentTaskProgress}}% 进度</text>
      </view>
      <view class="hero-metric">
        <text class="metric-label">目标 / 距离</text>
        <text class="metric-value small">{{robot.current_target || '--'}}</text>
        <text class="metric-note">{{robot.remaining_distance === '--' ? '--' : robot.remaining_distance + 'm'}}</text>
      </view>
      <view class="hero-metric {{robot.emergency_stop || alarmActive ? 'danger' : ''}}">
        <text class="metric-label">风险</text>
        <text class="metric-value small">{{robot.emergency_stop ? '急停' : alarmActive ? '告警' : '正常'}}</text>
        <text class="metric-note">{{robot.fault_code && robot.fault_code !== '--' ? robot.fault_code : '无故障码'}}</text>
      </view>
    </view>

    <view class="voice-command-panel">
      <view class="voice-panel-head">
        <view>
          <text class="panel-kicker">Smart Command</text>
          <text class="panel-title">语音 / 文本指令</text>
        </view>
        <text class="voice-state {{isRecording ? 'recording' : ''}}">{{isRecording ? '识别中' : '待命'}}</text>
      </view>
      <view class="voice-input-row hero-input-row">
        <input
          class="voice-input"
          placeholder="说出或输入：去一号点、开始巡检、暂停任务"
          value="{{voiceText}}"
          bindinput="onVoiceInput"
          bindconfirm="sendVoiceCommand"
          confirm-type="send"
        />
        <view class="mic-btn {{isRecording ? 'recording' : ''}}" bindtap="startVoiceRecognition">
          <text class="mic-icon">Mic</text>
        </view>
        <view class="send-btn" bindtap="sendVoiceCommand">
          <text class="send-icon">发送</text>
        </view>
      </view>
      <view class="quick-question-row">
        <view class="quick-question-chip" wx:for="{{quickQuestions}}" wx:key="*this" bindtap="useQuickQuestion" data-text="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
      <view class="smart-result hero-smart-result" wx:if="{{smartRecognizedText !== '--' || smartReply !== '等待语音或文本指令'}}">
        <text class="smart-recognized-label">识别文本</text>
        <text class="smart-recognized-text">{{smartRecognizedText === '--' ? voiceText : smartRecognizedText}}</text>
        <view class="smart-reply {{smartError ? 'error' : ''}}">{{smartReply}}</view>

        <view class="mission-confirm-card" wx:if="{{smartNeedConfirm && smartPendingId}}">
          <view class="confirm-card-top">
            <text class="confirm-card-kicker">CONFIRMATION REQUIRED</text>
            <text class="confirm-card-title">运动指令确认</text>
          </view>
          <text class="confirm-card-body">该指令将控制机器人运动，请确认解析无误后再执行。</text>
          <view class="confirm-card-meta">
            <text class="confirm-meta-item">意图: {{smartIntent}}</text>
            <text class="confirm-meta-item">解析: {{smartParser}}</text>
          </view>
          <view class="confirm-card-actions">
            <view class="confirm-cancel-btn {{confirmingMission ? 'disabled' : ''}}" bindtap="cancelMissionCommand">
              <text>取消</text>
            </view>
            <view class="confirm-go-btn {{confirmingMission ? 'disabled' : ''}}" bindtap="confirmMissionCommand">
              <text>{{confirmingMission ? '提交中...' : '确认执行'}}</text>
            </view>
          </view>
        </view>

        <view class="debug-toggle" bindtap="toggleSmartDebug">
          <text>{{showSmartDebug ? '收起调试详情' : '展开调试详情'}}</text>
          <text class="debug-arrow {{showSmartDebug ? 'open' : ''}}">▾</text>
        </view>
        <view class="debug-details" wx:if="{{showSmartDebug}}">
          <view class="debug-item"><text class="debug-key">意图</text><text class="debug-val">{{smartIntent}}</text></view>
          <view class="debug-item"><text class="debug-key">解析器</text><text class="debug-val">{{smartParser}}</text></view>
          <view class="debug-item"><text class="debug-key">TTS</text><text class="debug-val">{{smartTtsStatus}}</text></view>
          <view class="debug-item"><text class="debug-key">待确认</text><text class="debug-val">{{smartNeedConfirm ? '是' : '否'}}</text></view>
          <view class="debug-item" wx:if="{{smartPendingId}}"><text class="debug-key">Pending ID</text><text class="debug-val mono">{{smartPendingId}}</text></view>
          <view class="debug-item" wx:if="{{smartError}}"><text class="debug-key">错误</text><text class="debug-val error">{{smartError}}</text></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 实时图像卡片 -->
  <view class="card image-card">
    <view class="card-title">
      <text class="title-mark">IMG</text>
      <text>实时运行图像</text>
      <text class="image-tag" wx:if="{{hasImage}}">{{videoHealthStatusText}}</text>
    </view>
    <view class="video-health-row">
      <view class="video-health-item">
        <text class="health-label">YOLO</text>
        <text class="health-value">{{yoloStatusText}}</text>
      </view>
      <view class="video-health-item">
        <text class="health-label">最新帧</text>
        <text class="health-value">{{frameFreshText}}</text>
      </view>
    </view>
    <view class="image-container">
      <image
        class="robot-image"
        src="{{imageDataUri}}"
        mode="aspectFit"
        bindtap="previewImage"
        wx:if="{{imageDataUri}}"
      />
      <view class="image-placeholder" wx:else>
        <text class="placeholder-mark">NO IMAGE</text>
        <text class="placeholder-text">{{frameStatusText}}</text>
      </view>
    </view>
    <text class="video-health-detail">{{videoHealthDetail}}</text>
  </view>

  <!-- 视觉事件卡片 -->
  <view class="card">
    <view class="card-title">
      <text class="title-mark">EYE</text>
      <text>最近视觉事件</text>
      <text class="image-tag">{{perceptionEvents.length}} 条</text>
    </view>
    <view class="vision-event-list" wx:if="{{perceptionEvents.length > 0}}">
      <view class="vision-event-item {{item.level}}" wx:for="{{perceptionEvents}}" wx:key="id">
        <view class="vision-event-main">
          <text class="vision-event-type">{{item.typeText}}</text>
          <text class="vision-event-message">{{item.message}}</text>
        </view>
        <view class="vision-event-meta">
          <text>{{item.className}}</text>
          <text>{{item.confidenceText}}</text>
          <text>{{item.countText}}</text>
          <text>{{item.timeText}}</text>
        </view>
      </view>
    </view>
    <view class="empty-inline" wx:else>
      <text>暂无持久化视觉事件</text>
    </view>
  </view>

  <!-- 天气卡片 -->
  <view class="card weather-card">
    <view class="card-title">
      <text class="title-mark">WX</text>
      <text>外部天气</text>
      <text class="image-tag">{{weatherStatusText}}</text>
    </view>
    <view class="weather-grid" wx:if="{{weather}}">
      <view class="weather-main">
        <text class="weather-location">{{weather.location}}</text>
        <text class="weather-temp">{{weather.temperature}}℃</text>
        <text class="weather-desc">{{weather.weather}} · 体感 {{weather.apparent}}℃</text>
      </view>
      <view class="weather-metrics">
        <view><text class="weather-label">湿度</text><text class="weather-value">{{weather.humidity}}%</text></view>
        <view><text class="weather-label">降雨</text><text class="weather-value">{{weather.rain}}%</text></view>
        <view><text class="weather-label">UV</text><text class="weather-value">{{weather.uv}}</text></view>
      </view>
    </view>
    <text class="weather-advice">{{weatherAdvice}}</text>
  </view>

  <!-- 环境监测卡片 -->
  <view class="card">
    <view class="card-title">
      <text class="title-mark">ENV</text>
      <text>环境监测</text>
      <view class="flame-indicator {{sensors.flame ? 'alert' : ''}}" wx:if="{{sensors.flame !== undefined}}">
        <text class="flame-dot"></text>
        <text>{{sensors.status}}</text>
      </view>
    </view>
    <view class="sensor-grid">
      <view class="sensor-item">
        <text class="sensor-label">温度</text>
        <text class="sensor-value">{{sensors.temperature}} <text class="sensor-unit">℃</text></text>
        <view class="sensor-bar">
          <view class="sensor-bar-fill co" style="width: {{sensors.temperature === '--' ? 0 : 55}}%;"></view>
        </view>
      </view>
      <view class="sensor-item">
        <text class="sensor-label">湿度</text>
        <text class="sensor-value">{{sensors.humidity}} <text class="sensor-unit">%</text></text>
        <view class="sensor-bar">
          <view class="sensor-bar-fill ch4" style="width: {{sensors.humidity === '--' ? 0 : 60}}%;"></view>
        </view>
      </view>
      <view class="sensor-item">
        <text class="sensor-label">本体传感器</text>
        <text class="sensor-value muted-value">{{sensors.status}}</text>
        <view class="air-quality-level">CO/CH₄/AQI</view>
      </view>
      <view class="sensor-item">
        <text class="sensor-label">YOLO 识别</text>
        <text class="sensor-value perception-value">{{perception.detection || '暂无视觉数据'}}</text>
        <view class="sensor-bar" wx:if="{{perception.confidence !== undefined}}">
          <view class="sensor-bar-fill confidence" style="width: {{confidenceBarWidth}}%;"></view>
        </view>
        <text class="confidence-text" wx:if="{{perception.confidence !== undefined}}">{{confidencePct}}%</text>
      </view>
    </view>
  </view>

  <!-- 机器人状态卡片 -->
  <view class="card">
    <view class="card-title">
      <text class="title-mark">BOT</text>
      <text>机器人状态</text>
      <view class="status-tag {{robot.status}}">{{statusText}}</view>
    </view>
    <view class="robot-grid">
      <view class="robot-info-item">
        <text class="info-label">电量</text>
        <view class="battery-container">
          <view class="battery-outer">
            <view class="battery-inner" style="width: {{batteryBarWidth}}%; background: {{batteryColor}};"></view>
          </view>
          <text class="battery-text" style="color: {{batteryColor}};">{{robot.battery}}%</text>
        </view>
      </view>
      <view class="robot-info-item">
        <text class="info-label">急停</text>
        <text class="info-value {{robot.emergency_stop ? 'danger' : 'safe'}}">{{robot.emergency_stop ? '已触发' : '正常'}}</text>
      </view>
      <view class="robot-info-item">
        <text class="info-label">故障码</text>
        <text class="info-value">{{robot.fault_code !== undefined ? robot.fault_code : '--'}}</text>
      </view>
      <view class="robot-info-item">
        <text class="info-label">运行时长</text>
        <text class="info-value">{{robot.running_hours === '--' ? '--' : robot.running_hours + 'h'}}</text>
      </view>
      <view class="robot-info-item">
        <text class="info-label">固件版本</text>
        <text class="info-value version">{{robot.firmware_version || '--'}}</text>
      </view>
      <view class="robot-info-item">
        <text class="info-label">系统模式</text>
        <text class="info-value">{{systemMode}}</text>
      </view>
      <view class="robot-info-item">
        <text class="info-label">后端时间</text>
        <text class="info-value">{{backendUpdatedAt}}</text>
      </view>
      <view class="robot-info-item">
        <text class="info-label">剩余距离</text>
        <text class="info-value">{{robot.remaining_distance === '--' ? '--' : robot.remaining_distance + 'm'}}</text>
      </view>
      <view class="robot-info-item">
        <text class="info-label">当前任务</text>
        <text class="info-value">{{currentTaskText}}</text>
      </view>
      <view class="robot-info-item">
        <text class="info-label">任务进度</text>
        <text class="info-value">{{currentTaskProgress}}%</text>
      </view>
    </view>
  </view>

  <!-- 导航信息卡片 -->
  <view class="card">
    <view class="card-title">
      <text class="title-mark">NAV</text>
      <text>导航信息</text>
      <text class="image-tag">{{navMapStatusText}}</text>
      <text class="target-name" wx:if="{{robot.current_target && robot.current_target !== '--'}}">{{robot.current_target}}</text>
    </view>
    <view class="nav-info">
      <view class="nav-pose">
        <text class="pose-label">位姿</text>
        <text class="pose-value">x: {{poseDisplayX}}  y: {{poseDisplayY}}  偏角: {{poseDisplayYaw}}</text>
      </view>
      <view class="nav-status">
        <text class="nav-status-label">导航状态</text>
        <text class="nav-status-value {{robot.status}}">{{navigationStatusText}}</text>
      </view>
      <view class="nav-imu">
        <text class="nav-status-label">导航链路</text>
        <text class="nav-imu-value">{{navigationWsConnected ? 'WSS navigation' : 'REST navigation'}} · {{navigationDetailText}}</text>
      </view>
      <view class="nav-imu">
        <text class="nav-status-label">IMU</text>
        <text class="nav-imu-value">{{imuText}}</text>
      </view>
      <view class="nav-imu">
        <text class="nav-status-label">最近命令</text>
        <text class="nav-imu-value">{{commandLogText}}</text>
      </view>
    </view>
    <!-- 导航简化示意图 -->
    <view class="nav-canvas-container">
      <canvas type="2d" id="navCanvas" class="nav-canvas"></canvas>
      <view class="nav-map-legend">
        <text class="legend-item global">全局路径</text>
        <text class="legend-item local">局部路径</text>
        <text class="legend-item goal">目标点</text>
      </view>
    </view>
    <text class="nav-map-detail">{{navMapDetailText}}</text>
  </view>

  <!-- 快捷指令卡片 -->
  <view class="card">
    <view class="card-title">
      <text class="title-mark">CMD</text>
      <text>快捷指令</text>
    </view>
    <view class="command-grid">
      <view class="cmd-btn cmd-auto" bindtap="sendCommand" data-cmd="auto">
        <text class="cmd-icon">▶</text>
        <text class="cmd-label">巡检</text>
      </view>
      <view class="cmd-btn cmd-stop" bindtap="sendCommand" data-cmd="stop">
        <text class="cmd-icon">Ⅱ</text>
        <text class="cmd-label">停止</text>
      </view>
      <view class="cmd-btn cmd-go" bindtap="sendCommand" data-cmd="go_to_1">
        <text class="cmd-icon">1</text>
        <text class="cmd-label">一号点</text>
      </view>
      <view class="cmd-btn cmd-go" bindtap="sendCommand" data-cmd="go_to_2">
        <text class="cmd-icon">2</text>
        <text class="cmd-label">二号点</text>
      </view>
      <view class="cmd-btn cmd-charge" bindtap="sendCommand" data-cmd="back_charge">
        <text class="cmd-icon">↩</text>
        <text class="cmd-label">回充</text>
      </view>
      <view class="cmd-btn cmd-emergency" bindtap="emergencyStop">
        <text class="cmd-icon">!</text>
        <text class="cmd-label">急停</text>
      </view>
    </view>
  </view>

  <!-- 提示消息 -->
  <view class="toast {{toastVisible ? 'show' : ''}}">{{toastMessage}}</view>

</view>
