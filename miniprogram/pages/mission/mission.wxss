.grow { flex: 1; }

.now { padding: 28rpx 32rpx; position: relative; }
.now::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; background: var(--run); }
.now.wait::before { background: var(--wait); }
.now-top { display: flex; align-items: center; }
.now-title { flex: 1; min-width: 0; margin-left: 16rpx; font-size: 32rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.now-pct { font-size: 32rpx; font-weight: 700; }
.now .bar { margin-top: 18rpx; height: 10rpx; border-radius: 999rpx; background: var(--surface-3); overflow: hidden; }
.now .bar-fill { height: 100%; background: var(--run); border-radius: inherit; }
.now-detail { display: block; margin-top: 12rpx; font-size: 24rpx; color: var(--ink-2); }
.now-acts { display: flex; margin-top: 20rpx; }
.now-acts .btn { flex: 1; height: 76rpx; }
.now-acts .btn + .btn { margin-left: 16rpx; }

.classes { display: flex; flex-wrap: wrap; margin: 0 -8rpx 20rpx; }
.cls { width: calc(33.333% - 16rpx); margin: 0 8rpx 16rpx; height: 132rpx; border-radius: 24rpx; border: 2rpx solid var(--line); display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 600; color: var(--ink-2); }
.cls.on { border-color: var(--brand); background: var(--brand-soft); color: var(--brand-deep); }
.cls-icon { width: 48rpx; height: 48rpx; margin-bottom: 8rpx; }
.colors { display: flex; margin-bottom: 36rpx; }
.sw { width: 72rpx; height: 72rpx; padding: 6rpx; margin-right: 18rpx; border-radius: 50%; border: 4rpx solid transparent; }
.sw.on { border-color: var(--ink); }
.sw-in { width: 100%; height: 100%; border-radius: 50%; box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.12); }
.follow { margin-top: 16rpx; }
.gap { margin-top: 24rpx; }
.hint { display: block; margin-top: 18rpx; font-size: 23rpx; color: var(--ink-3); }

.pt { display: flex; align-items: center; height: 96rpx; padding: 0 28rpx; border-radius: 24rpx; border: 2rpx solid var(--line); margin-bottom: 14rpx; }
.pt.on { border-color: var(--brand); background: var(--brand-soft); }
.pt-dot { width: 20rpx; height: 20rpx; border-radius: 50%; border: 4rpx solid var(--ink-3); }
.pt.on .pt-dot { border-color: var(--brand); background: var(--brand); }
.pt-name { flex: 1; margin-left: 20rpx; font-size: 28rpx; font-weight: 600; }
.pt.on .pt-name { color: var(--brand-deep); }
.pt-xy { font-size: 23rpx; color: var(--ink-3); }

.chain { display: flex; flex-wrap: wrap; align-items: center; padding: 24rpx; margin-bottom: 28rpx; border-radius: 24rpx; background: var(--surface-2); }
.chain-pt { padding: 8rpx 20rpx; margin: 6rpx 0; border-radius: 999rpx; background: var(--surface); font-size: 25rpx; font-weight: 600; box-shadow: 0 2rpx 6rpx rgba(21, 23, 26, 0.06); }
.chain-arrow { margin: 0 8rpx; color: var(--ink-3); font-size: 30rpx; }
