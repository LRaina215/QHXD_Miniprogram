/* 设置 - 链路与权限中心 */
.page-settings {
  padding-bottom: 60rpx;
  padding-bottom: calc(60rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: #F4F6F8;
}

.link-hero {
  margin: 16rpx 20rpx 12rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #15181C;
  color: #FFFFFF;
}

.link-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
}

.link-title-block {
  flex: 1;
  min-width: 0;
}

.link-kicker {
  display: block;
  color: rgba(255, 255, 255, 0.58);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.link-title {
  display: block;
  margin-top: 4rpx;
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.12;
}

.link-subtitle {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  overflow-wrap: anywhere;
}

.link-state {
  flex-shrink: 0;
  max-width: 100%;
  box-sizing: border-box;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.link-state.ready {
  color: #90F2B0;
  background: rgba(144, 242, 176, 0.13);
}

.link-state.locked {
  color: #FFD58A;
  background: rgba(255, 213, 138, 0.13);
}

.link-status-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-top: 22rpx;
}

.link-status-item {
  min-width: 0;
  min-height: 76rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 10rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
}

.link-status-item.ok { color: #90F2B0; }
.link-status-item.warn { color: #FFD58A; }
.link-status-item.bad { color: #FFB1AC; }

.status-label {
  color: rgba(255, 255, 255, 0.48);
  font-size: 17rpx;
  font-weight: 700;
}

.status-value {
  margin-top: 4rpx;
  color: currentColor;
  font-size: 22rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.health-detail-card {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: #15181C;
  background: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.hero-refresh-btn {
  min-height: 72rpx;
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.14);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-refresh-btn:active {
  opacity: 0.82;
}

/* 模式切换卡片 */
.mode-card {
  margin-top: 14rpx;
}

.mode-badge {
  margin-left: auto;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.mode-badge.mock {
  color: #C76B15;
  background: #FFF3E0;
}

.mode-badge.real {
  color: #1A6DD4;
  background: #E8F0FE;
}

.mode-token-warn {
  margin-bottom: 14rpx;
  padding: 12rpx 18rpx;
  border-radius: 10rpx;
  background: #FFF0EC;
  color: #C42E2A;
  font-size: 21rpx;
  font-weight: 600;
  text-align: center;
  border: 1rpx solid rgba(196, 46, 42, 0.18);
}

.mode-description {
  margin-bottom: 20rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #F9F9FB;
  color: #6E6E73;
  font-size: 22rpx;
  line-height: 1.55;
}

.mode-switch-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.mode-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
  opacity: 0.45;
  transition: opacity 0.2s;
}

.mode-option.active {
  opacity: 1;
}

.mode-option-label {
  font-size: 26rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.mode-option-desc {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #8E8E93;
}

.mode-toggle {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 14rpx;
}

.mode-toggle:active {
  background: rgba(0, 0, 0, 0.04);
}

.mode-toggle.busy {
  opacity: 0.45;
  pointer-events: none;
}

.toggle-track {
  width: 104rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #E5E5EA;
  position: relative;
  transition: background 0.25s;
}

.toggle-track.on {
  background: #F5A623;
}

.toggle-thumb {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  transition: left 0.25s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.toggle-track.on .toggle-thumb {
  left: 54rpx;
}

.mode-status-text {
  margin-top: 16rpx;
  text-align: center;
  color: #8E8E93;
  font-size: 21rpx;
}

.token-card {
  margin-top: 14rpx;
}

.card-subtitle {
  margin-left: auto;
  font-size: 20rpx;
  color: #C7C7CC;
}

.form-group {
  margin-bottom: 16rpx;
}

.form-label {
  display: block;
  margin-bottom: 6rpx;
  color: #8E8E93;
  font-size: 22rpx;
  font-weight: 600;
}

.form-input {
  width: 100%;
  min-height: 76rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  color: #15181C;
  background: #F9F9FB;
  font-size: 24rpx;
}

.form-input:focus {
  border-color: #1677FF;
}

.save-config-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #FFFFFF;
  background: #15181C;
  font-size: 24rpx;
  font-weight: 700;
}

.save-config-btn:active {
  opacity: 0.85;
}

.alarm-count {
  margin-left: auto;
  min-width: 28rpx;
  padding: 1rpx 12rpx;
  border-radius: 16rpx;
  color: #FFFFFF;
  background: #C42E2A;
  font-size: 18rpx;
  font-weight: 700;
  text-align: center;
}

.alarm-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  max-height: 360rpx;
  overflow-y: auto;
}

.alarm-item {
  display: flex;
  flex-direction: column;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #FFF5F5;
}

.alarm-time {
  margin-bottom: 2rpx;
  color: #AEAEB2;
  font-size: 18rpx;
}

.alarm-msg {
  color: #3A3A3C;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.debug-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}

.debug-row:last-of-type {
  border-bottom: none;
}

.debug-label {
  flex-shrink: 0;
  color: #8E8E93;
  font-size: 22rpx;
  font-weight: 600;
}

.debug-value {
  min-width: 0;
  color: #15181C;
  font-size: 21rpx;
  font-weight: 600;
  text-align: right;
  overflow-wrap: anywhere;
}

.network-note {
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 10rpx;
  color: #6E6E73;
  background: #F9F9FB;
  font-size: 21rpx;
  line-height: 1.45;
}

.about-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.about-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}

.about-row:last-child {
  border-bottom: none;
}

.about-label {
  flex-shrink: 0;
  color: #8E8E93;
  font-size: 24rpx;
}

.about-value {
  min-width: 0;
  color: #15181C;
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
  overflow-wrap: anywhere;
}

.clear-cache-card {
  background: #FFF5F5;
}

.clear-cache-row {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  color: #C42E2A;
  font-size: 26rpx;
  font-weight: 700;
}
